extends ../layouts/admin-layout
block content
    .container.py-5
        .row
            .col-md-12.mb-3
                h1 Publicaciones
        .row.mb-4
            .col-md-12.mb-3
                .btn-group
                    a.btn.btn-primary(href="#", data-bs-toggle="modal", data-bs-target="#newPostModal") Nuevo
        .row
            .col-md-12
                if posts && posts.length > 0
                    .table-responsive
                        table.table.align-middle
                            thead
                                tr
                                    th Título
                                    th Categoría
                                    th Fecha
                                    th Estado
                                    th
                            tbody
                                each post in posts
                                    tr
                                        td= post.title
                                        td= post.category || '-'
                                        td= post.date ? new Date(post.date).toLocaleDateString() : '-'
                                        td
                                            if post.draft
                                                span.badge.bg-warning Borrador
                                            else
                                                span.badge.bg-success Publicado
                                        td.text-end
                                            a.btn.btn-sm.btn-outline-secondary.me-2(href=`/dashboard/posts/${post.slug}/edit`) Editar
                                            form(method="POST" action=`/dashboard/posts/${post.slug}/delete` style="display:inline" onsubmit="return confirm('¿Eliminar este post?')")
                                                button.btn.btn-sm.btn-outline-danger(type="submit") Eliminar
                                            a.btn.btn-sm.btn-outline-primary.ms-2(href=`/post/${post.slug}` target="_blank") Ver
                else
                    p.text-secondary No hay publicaciones.
