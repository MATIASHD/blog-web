extends ../layouts/admin-layout
block content
    .container.py-5
        .row
            .col-md-12.mb-3
                h1 Publicaciones
        .row.mb-4
            .col-md-12.mb-3
                .btn-group
                    a.btn.btn-primary(href="/admin/posts/new") Nuevo
                    button.btn.btn-primary(id="editSelectedBtn" disabled) Editar
                    button.btn.btn-primary(id="deleteSelectedBtn" disabled) Eliminar
            .col-md-12.mb-3
                if posts && posts.length > 0
                    include ../components/table.pug
                    +table(['Titulo', 'Categoria', 'Fecha', 'Estado'], posts.map(post => [post.title, post.category || '-', post.date || '-', post.draft ? `Borrador` : `Publicado` ]), 4)
                else
                    p No hay publicaciones todavia.
