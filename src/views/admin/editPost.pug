extends ../layouts/admin-layout
block content
  .container.py-5
    .row
      .col-md-12.mb-3
        h1= title
    if error
      .alert.alert-danger= error
    .row
      .col-md-8
        form(action=`/dashboard/posts/${post.slug}/edit` method="POST")
          include ../partials/post-form.pug
          .mb-3.form-check
            input.form-check-input(type="checkbox" id="draft" name="draft" checked=post.draft)
            label.form-check-label(for="draft") Borrador
          button.btn.btn-primary(type="submit") Guardar Cambios
