extends ../layouts/admin-layout
block content
    .container.py-4
        .row.g-4.mb-4 
            .col-xl-3.col-md-6 
                .card.p-3 
                    h3= stats ? stats.totalPosts : 0
                    p Posts
            .col-xl-3.col-md-6 
                .card.p-3 
                    h3= stats ? stats.totalContacts : 0
                    p Contactos
            .col-xl-3.col-md-6 
                .card.p-3 
                    h3= stats ? stats.unreadContacts : 0
                    p Sin leer
            .col-xl-3.col-md-6 
                .card.p-3 
                    h3= stats ? stats.subscribers : 0
                    p Suscriptores
        .row.g-4 
            .col-lg-8 
                .chart-card 
                    if stats && stats.recentPosts && stats.recentPosts.length
                        ul.list-group
                            include ../components/table.pug
                            +table(['Posts recientes'], stats.recentPosts.map(post => [post.title]), 1)
                    else
                        p.text-secondary No hay posts cargados.
            .col-lg-4 
                .popular-posts 
                    if stats && stats.recentContacts && stats.recentContacts.length
                        ul.list-group
                            include ../components/table.pug
                            +table(['Contactos recientes'], stats.recentContacts.map(contact => [contact.email]), 1)
                    else
                        p.text-secondary No hay mensajes.