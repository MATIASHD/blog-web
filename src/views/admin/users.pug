extends ../layouts/admin-layout
block content
    .container.py-5
        .row
            .col-md-12.mb-3
                h1 Usuarios
        .row.mb-4
            .col-md-12.mb-3
                .btn-group
                    a.btn.btn-primary(href="/dashboard/users/new") Nuevo
                    button.btn.btn-primary(id="editSelectedBtn" disabled) Editar
                    button.btn.btn-primary(id="deleteSelectedBtn" disabled) Eliminar
        .row
            .col-md-12.mb-3
                if users && users.length > 0
                    include ../components/table.pug
                    +table(['Nombre', 'Email', 'Rol', 'Activo'], users.map(u => [u.name, u.email, u.role, u.is_active ? 'Sí' : 'No', u.id]), 4)
                else
                    p No hay usuarios registrados.
