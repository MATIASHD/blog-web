extends ../layouts/admin-layout
block content
    .container.py-5
        .row
            .col-md-12.mb-3
                h1 Usuarios
        .row.mb-4
            .col-md-12.mb-3
                include ../components/btnBar.pug
                +btnBar([["Nuevo","users/new"]])
        .row 
            .col-md-12.mb-3
                include ../components/table.pug
                if users && users.length > 0
                    +table(['Nombre', 'Email', 'Rol', 'Activo'], users.map(u => [u.name, u.email, u.role, u.is_active ? 'Sí' : 'No']))
                else
                    p No hay usuarios registrados.