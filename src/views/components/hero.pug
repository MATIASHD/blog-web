mixin hero(titulo, descripcion, imagen, boton)
  section.hero-section.text-white.d-flex.align-items-center.position-relative.overflow-hidden
    .bg-primary.position-absolute.top-0.start-0.w-100.h-100.opacity-75
    if imagen
      img.position-absolute.top-0.start-0.w-100.h-100.object-fit-cover(src=imagen alt="" style="z-index: -1")
    .container.position-relative(style="z-index: 1")
      .row.justify-content-center.text-center.py-5
        .col-lg-8
          h1.display-4.fw-bold= titulo
          if descripcion
            p.lead.mb-4= descripcion
          if boton
            a.btn.btn-light.btn-lg.px-5.rounded-pill(href=boton.url)= boton.texto
