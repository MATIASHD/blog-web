mixin formularioDeNewsletter(placeholder, botonTexto)
    .row.justify-content-center
      .col-md-9
        .card-body.mb-3
          form.newsletter-form(action="/newsletter" method="POST")
            .input-group.border-bottom.border-black.border-3
              input.form-control.border-0(type="email" name="email" placeholder=placeholder || "tu@email.com" required)
              button.btn(type="submit")= botonTexto || "Suscribirse"
