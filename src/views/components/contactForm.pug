mixin contactForm()
    form(action="/contact" method="POST")
        .row.g-3.figure-caption
            .col-md-6.border-bottom.border-black.border-3
              label.form-label(for="nombre") Nombre
              input.border-0.form-control#nombre(type="text" name="nombre" required)
            .col-md-6.border-bottom.border-black.border-3
              label.form-label(for="email") Email
              input.border-0.form-control#email(type="email" name="email" required)
            .col-12.border-bottom.border-black.border-3
              label.form-label(for="asunto") Asunto
              input.border-0.form-control#asunto(type="text" name="asunto" required)
            .col-12.border-bottom.border-black.border-3
              label.form-label(for="mensaje") Mensaje
              textarea.border-0.form-control#mensaje(name="mensaje" rows="5" required)
            .col-12
              button.btn.btn-outline-dark(type="submit") Enviar mensaje