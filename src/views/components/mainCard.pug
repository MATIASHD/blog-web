mixin mainCard(img, imgAlt, link, tags, title, description)
    .featured-card.card.h-100.rounded-2.p-2
        include blockImagen.pug
        +blockImagen(img, imgAlt, title)
        h2.fs-3.card-title 
            a.text-dark(href=`/post/${link}`)= title
        p.lead.text-body-secondary.lh-sm.card-description= description