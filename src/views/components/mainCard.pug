mixin mainCard(img, imgAlt, link, tags, title, description)
    .featured-card.card.h-100.rounded-5 
        img.card-img-top.rouded-5.object-fit-cover(src=img, alt=imgAlt, class='img-fluid rounded')
        .card-body 
            include ../components/badge.pug 
            +badge(tags)
            h2.fs-3.card-title 
                a.text-dark(href=`/blog/${link}`)= title
            p.figure-caption.text-body-tertiary.card-text= description