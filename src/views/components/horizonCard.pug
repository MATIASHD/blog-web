mixin horizonCard(titulo, img, imgDescription, description, author)
    .card.mb-3
        .row.g-0
            .col-md-4 
                img.img-fluid.rounded-start(src=img alt=imgDescription)
            .col-md-8 
                .card-body 
                    h5.card-title= titulo
                    p.card-text= description 
                    p.card-text 
                        small.text-muted author 

