extends ../layouts/base.pug 
block content
    .container
        .row 
            .col-sm-12.col-md-12.col-lg-12.figure-caption.d-flex.justify-content-center.align-items-center
                .col-6
                    .card-body.p-4 
                        h3 Iniciar sesion
                        form(action="#", method="get")
                            .mb-3
                                label(class="form-label" for="user") Usuario:
                                input(type="email" class="form-control" id="user")
                            .mb-3
                                label(class="form-label" for="pass") Contraseña
                                input(type="password" class="form-control" id="pass")
                            .mb-3.form-check
                                input(type="checkbox" class="form-check-input" id="recordar")
                                label(class="form-check-label" for="recordar") Recordarme 
                            button.btn.btn-primary(type="submit") Iniciar sesion
