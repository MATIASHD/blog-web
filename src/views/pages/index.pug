extends ../layouts/base.pug
block content
    header.py-5
        section.blog-section
            .container.mb-5
                .row
                    .col-lg-12.mb-3 
                        h1 Últimas noticias
                .row.g-4
                    if posts && posts.length
                        .col-lg-6
                            include ../components/mainCard.pug 
                            +mainCard(posts[0].imagenes, "Hero Image", posts[0].link, posts[0].tags[0], posts[0].titulo, posts[0].descripcion)
                        .col-lg-6
                            .d-flex.flex-column.gap-4.h-100 
                                if posts.length > 1
                                    each post in posts.slice(1, 4)
                                        include ../components/postDescriptionCard.pug
                                        +postDescriptionCard(post.tags, post.titulo, post.link, post.descripcion)
                    else
                        .col-12
                            p.text-secondary No hay publicaciones todavia.
        
        section
            .container.py-5
                .row
                    .col-lg-12.mb-3 
                        h1 Todos los posts
                .row
                    if posts && posts.length
                    include ../components/generalCard.pug
                    each post in posts 
                        .col-md-4 
                            +generalCard(post.titulo, post.descripcion, "2.jpg", post.link, post.fecha)
        