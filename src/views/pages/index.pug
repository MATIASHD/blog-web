extends ../layouts/base.pug
block content
    header
        section.blog-section
            .container.mb-5
                .row
                    .col-lg-12.mb-3 
                        h1 Últimas noticias
                .row.g-4
                    .col-lg-6
                        include ../components/mainCard.pug 
                        +mainCard(posts[0].imagenes, "Hero Image", posts[0].link, posts[0].tags[0], posts[0].titulo, posts[0].descripcion)
                    .col-lg-6
                        .d-flex.flex-column.gap-4.h-100 
                            if posts && posts.length > 1
                                each post in posts.slice(1, 4)
                                    include ../components/postDescriptionCard.pug
                                    +postDescriptionCard(post.tags, post.titulo, post.link, post.descripcion)
        section
            .container.py-5
                .row 
                    .col-lg-12 
                        include ../components/formularioDeNewsletter.pug 
                        +formularioDeNewsletter("Seguimo para saber mas ", "Suscribime")