extends ../layouts/base.pug 
block content
    section.blog-section.py-5
        .container
            .row.g-4
                .col-lg-6
                    article.featured-card.card.h-100
                        img.card-img-top(src=posts[0].imagenes, alt='Hero Image' class='img-fluid rounded')
                        .card-body 
                            span.category IA/ML 
                            h2.card-title 
                                a(href=`/blog/${posts[0].link}`) casa 
                            p.card-text posts[0].titulo 
                .col-lg-6
                    .d-flex.flex-column.gap-4.h-100 
                        if posts && posts.length
                            each post in posts
                                article.small-card.card 
                                    .card-body 
                                        span.category Security 
                                            h3.card-title
                                                a(href=`/blog/${post.link}`) casa
                                            p.card-text 
                                                = post.descripcion