extends ../layouts/base.pug
block content
  .container
    .row.mb-4
      .col-12
        h1 Blog
        p.text-secondary Explora todos los articulos
    .row.mb-4
      .col-12
        include ../components/barraDeFiltro.pug
        include ../components/barraDeBusqueda.pug
        +barraDeFiltro(todasLasCategorias, todosLosTags)
    .row
      .col-lg-8
        if posts && posts.length
          include ../components/horizonCard.pug
          each post in posts
            +horizonCard(post.title, post.image, post.title, post.description, post.author)
        
        else
          .text-center.py-5
            i.bi.bi-journal-text.display-1.text-secondary
            h4.mt-3 No hay publicaciones aun
            p.text-secondary Vuelve pronto para ver nuevos articulos.
      .col-lg-4
        .card.shadow-sm.rounded-4.mb-4
          .card-body
            h5 Categorias
            include ../components/listaDeCategoria.pug
            +listaDeCategoria(todasLasCategorias || [])
        .card.shadow-sm.rounded-4
          .card-body
            h5 Tags
            include ../components/listaDeTags.pug
            +listaDeTags(todosLosTags || [])
