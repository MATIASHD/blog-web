extends ../layouts/base.pug

block content
  .container
    .row
      .d-flex.justify-content-center.align-items-center.resetNav
        .col-lg-8
          h1.mb-4 ¡Hola! ¿En qué podemos ayudarte?
          p.text-secondary.mb-5 Si tienes alguna pregunta, sugerencia o simplemente quieres saludar, completa el formulario.
          if mensaje
            .alert.alert-success= mensaje
          include ../components/contactForm.pug
          +contactForm()
