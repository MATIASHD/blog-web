extends ../layouts/base.pug
block content
  .container
    .row
      .d-flex.justify-content-center.align-items-center.resetNav
        .col-lg-8
          h1 ¡Hola! ¿En qué podemos ayudarte?
          p.text-body-secondary.card-description.mb-5 Si tienes alguna pregunta, sugerencia o simplemente quieres saludar, completa el formulario.
          if mensaje
            .alert.alert-success= mensaje
          if error
            .alert.alert-danger= error
          include ../components/contactForm.pug
          +contactForm()
