extends ../layouts/base.pug
block content
  - var _siteUrl = siteUrl || 'https://arevdev.com'
  - var _currentUrl = _siteUrl + (req ? req.originalUrl : '/')
  if post
    script(type="application/ld+json").
      {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        "headline": "#{post.title.replace(/"/g, '\\"')}",
        "description": "#{(post.description || post.seoDescription || '').replace(/"/g, '\\"')}",
        "image": "#{post.image || '/images/default-og.png'}",
        "url": "#{_currentUrl}",
        "datePublished": "#{new Date(post.date).toISOString()}",
        "dateModified": "#{new Date(post.updatedAt || post.date).toISOString()}",
        "author": { "@type": "Person", "name": "#{(post.author || 'Matías Arevalo').replace(/"/g, '\\"')}" },
        "publisher": { "@type": "Person", "name": "Matías Arevalo" },
        "mainEntityOfPage": { "@type": "WebPage", "@id": "#{_currentUrl}" }
      }
  .container.my-5
    .row.justify-content-md-center
      article.col-lg-7.col-md-12.col-sm-12
        if post
          h1.fs-main-title= post.title
          h2.lead.fs-5.mb-4= post.description
          p.detail.figure-caption.text-body-tertiary
            | #{new Date(post.date).toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}
            | por 
            | #{post.author}
          .text-body-tertiary.mb-4
            hr
          != post.htmlContent
          hr
          if post.tags && post.tags.length
            h5.mb-3 Etiquetas: 
            include ../components/listaDeTags.pug
            +listaDeTags(post.tags)
        else
          h1 Artículo no encontrado
          p No se pudo encontrar el artículo solicitado.
