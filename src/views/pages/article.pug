extends ../layouts/base.pug
block content
    .container
        .row.justify-content-md-center
            article.col-lg-7.col-md-12.col-sm-12
                if post
                    h1.fs-main-title= post.title
                    p.lead.fs-5.mb-4= post.description
                    p.detail.figure-caption.text-body-tertiary
                        time(datetime=post.date)= new Date(post.date).toLocaleDateString(lang === 'en' ? 'en-US' : 'es-ES', { year: 'numeric', month: 'long', day: 'numeric' })
                        |  · #{post.author}
                        if post.category
                            |  · #{post.category}
                    if post.image
                        img.img-fluid.rounded.mb-4(src=post.image alt=post.title loading="lazy")
                    .text-body-tertiary.mb-4
                        hr
                    != post.htmlContent
                    if post.tagLinks && post.tagLinks.length
                        footer.mt-5.pt-3.border-top
                            p.mb-2
                                strong= (lang === 'en' ? 'Tags:' : 'Etiquetas:')
                            each tag in post.tagLinks
                                a.badge.bg-secondary.text-decoration-none.me-1(href=`${langPrefix}/tags/${tag.slug}`)= tag.nombre
                else
                    h1= (lang === 'en' ? 'Article not found' : 'Artículo no encontrado')
                    p= (lang === 'en' ? 'The requested article could not be found.' : 'No se pudo encontrar el artículo solicitado.')
