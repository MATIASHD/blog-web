extends ../layouts/admin-layout

block content
  .d-flex.justify-content-between.align-items-center.mb-4
    h1 Posts
    a.btn.btn-primary(href="/admin/posts/new") Nuevo post
  if posts && posts.length
    .table-responsive
      table.table.align-middle
        thead
          tr
            th Titulo
            th Categoria
            th Fecha
            th
        tbody
          each post in posts
            tr
              td= post.title
              td= post.category || '-'
              td= post.date || '-'
              td.text-end
                a.btn.btn-sm.btn-outline-secondary.me-2(href=`/admin/posts/${post.slug}/edit`) Editar
                a.btn.btn-sm.btn-outline-primary(href=`/blog/${post.slug}`) Ver
  else
    p.text-secondary No hay posts todavia.
