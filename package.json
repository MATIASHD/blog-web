{
  "name": "blog",
  "version": "1.0.0",
  "description": "Blog de desarrollo",
  "main": "server.js",
  "scripts": {
    "sass": "sass src/sass/main.scss:src/public/css/main.css && cp \"node_modules/bootstrap-icons/font/fonts/*\" src/public/fonts/",
    "sass:watch": "sass --watch --quiet src/sass/main.scss:src/public/css/main.css",
    "build": "node build.js",
    "build:css": "npm run sass && npm run build",
    "start": "concurrently \"npm run sass:watch\" \"nodemon\"",
    "start:prod": "npm run build && node server.js"
  },
  "author": "Matias Arevalo",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "bootstrap-icons": "^1.13.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.19.0",
    "gray-matter": "^2.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "markdown-it": "^14.3.0",
    "marked": "^18.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.2.0",
    "pg": "^8.22.0",
    "pug": "^3.0.4",
    "sanitize-html": "^2.17.3",
    "webpack": "^5.106.2"
  },
  "devDependencies": {
    "bootstrap": "^5.3.8",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.14",
    "prisma": "^7.8.0",
    "sass": "^1.99.0"
  }
}
