{
  "name": "blog",
  "version": "1.0.0",
  "description": "Blog de desarrollo",
  "main": "server.js",
  "scripts": {
    "sass": "sass src/sass/main.scss:src/public/css/main.css && cpx \"node_modules/bootstrap-icons/font/fonts/*\" src/public/fonts/",
    "sass:watch": "sass --watch --quiet src/sass/main.scss:src/public/css/main.css",
    "start": "concurrently \"npm run sass:watch\" \"nodemon\""
  },
  "author": "Matias Arevalo",
  "license": "ISC",
  "dependencies": {
    "bootstrap-icons": "^1.13.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "gray-matter": "^4.0.3",
    "helmet": "^8.1.0",
    "marked": "^18.0.3",
    "morgan": "^1.10.1",
    "sanitize-html": "^2.17.3",
    "webpack": "^5.106.2"
  },
  "devDependencies": {
    "bootstrap": "^5.3.8",
    "concurrently": "^9.2.1",
    "connect-livereload": "^0.6.1",
    "cpx": "^1.5.0",
    "gulp": "^5.0.1",
    "gulp-concat": "^2.6.1",
    "gulp-minify-css": "^1.2.4",
    "gulp-pug": "^5.0.0",
    "gulp-sass": "^6.0.1",
    "gulp-sourcemaps": "^2.6.5",
    "gulp-uglify": "^3.0.2",
    "live-server": "^1.2.2",
    "livereload": "^0.10.3",
    "nodemon": "^3.1.14",
    "pug-cli": "^1.0.0-alpha6",
    "sass": "^1.99.0"
  }
}
