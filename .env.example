PORT=3000
NODE_ENV=development
SITE_URL=https://arevdev.com

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/blog?schema=public"
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Admin credentials
ADMIN_EMAIL=admin@blog.com
ADMIN_PASSWORD=your-secure-password

# Session
SESSION_SECRET=your-random-secret-here

# JWT
JWT_ACCESS_SECRET=your-access-secret-here
JWT_REFRESH_SECRET=your-refresh-secret-here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# GitHub (for post content repository)
GITHUB_TOKEN=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=
GITHUB_BRANCH=main
GITHUB_PUBLISHED_PATH=publicaciones
GITHUB_DRAFTS_PATH=borradores

# GitHub Webhook (for auto-build on push)
GITHUB_WEBHOOK_SECRET=
