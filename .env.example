PORT=3000
NODE_ENV=development
SITE_URL=https://arevdev.com

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/blog?schema=public"
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Admin credentials
ADMIN_EMAIL=admin@blog.com
ADMIN_PASSWORD=your-secure-password

# Session
SESSION_SECRET=your-random-secret-here

# JWT
JWT_ACCESS_SECRET=your-access-secret-here
JWT_REFRESH_SECRET=your-refresh-secret-here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# GitHub (for post content repository)
# Token permissions needed:
#   - Contents: Read & Write (para CRUD de artículos desde el dashboard)
#   - Metadata: Read (necesario para cualquier operación)
#   - Commit status: Read (opcional, para verificar estado del build)
# Crear un Fine-Grained Personal Access Token con acceso solo al repositorio de artículos
GITHUB_TOKEN=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=
GITHUB_BRANCH=main
GITHUB_PUBLISHED_PATH=Publicados
GITHUB_DRAFTS_PATH=Borrador

# GitHub Webhook (for auto-build on push)
# Generar con: openssl rand -hex 32
# Configurar en GitHub: repo Settings > Webhooks > Add webhook
# Payload URL: https://arevdev.com/webhook/github
# Content type: application/json
# Secret: (el mismo que abajo)
# Events: Just the push event
GITHUB_WEBHOOK_SECRET=

# Brevo (formerly Sendinblue) - Email service
# Obtener API key en: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
BREVO_FROM_EMAIL=noreply@arevdev.com
BREVO_FROM_NAME=Arevdev

# Error Tracking (Sentry)
SENTRY_DSN=

# Analytics (google / plausible / umami)
ANALYTICS_PROVIDER=
ANALYTICS_ID=
ANALYTICS_URL=
